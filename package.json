{
  "name": "odin6-pos",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm build:packages && next build",
    "start": "next start",
    "lint": "eslint src",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:unit": "node --experimental-strip-types --test \"src/shared/**/*.test.ts\" \"src/features/**/*.test.ts\" \"src/app/private/pos/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "build:packages": "tsc -p packages/types/tsconfig.json"
  },
  "dependencies": {
    "@odin6/types": "workspace:*",
    "@firebase/auth": "^1.10.8",
    "@firebase/storage": "^0.13.10",
    "@formkit/tempo": "^0.1.2",
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-avatar": "^1.1.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.97.0",
    "@tanstack/react-query-persist-client": "5.97.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/nodemailer": "^7.0.11",
    "browsers": "^1.0.2",
    "chrome": "^0.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "install": "^0.13.0",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.508.0",
    "mongodb": "^7.1.1",
    "next": "16.2.4",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.4",
    "puppeteer": "^24.11.1",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.1.0",
    "react-datepicker": "^8.4.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.3",
    "react-horizontal-scrolling-menu": "^8.2.0",
    "react-icons": "^5.5.0",
    "react-toastify": "^11.0.5",
    "recharts": "^3.1.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.2.0",
    "uuid": "^11.1.0",
    "yup": "^1.6.1",
    "zustand": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "bcrypt",
      "mongodb-memory-server",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.1.5",
    "@types/jest": "^29.5.0",
    "@types/node": "20.6.0",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "^10.4.24",
    "dotenv": "^17.4.1",
    "eslint": "9.26.0",
    "eslint-config-next": "15.3.2",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "postcss-preset-env": "^11.1.3",
    "prettier": "^3.6.0",
    "sharp": "^0.34.5",
    "tailwindcss": "4.1.5",
    "typescript": "5.8.3"
  }
}
