# Copiar a `.env` para desarrollo local. En builds de EAS las variables van en `eas.json`
# (cada perfil); EAS no lee este archivo.

# API del ambiente que usa el build
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_WS_URL=https://api.example.com

# Geocerca de RESPALDO para fichar asistencia. La manda el servidor; esto solo se usa si la
# API no la entrega. Sin valores, el fichaje queda negado hasta que el servidor la tenga.
EXPO_PUBLIC_GEOFENCE_LAT=
EXPO_PUBLIC_GEOFENCE_LNG=
EXPO_PUBLIC_GEOFENCE_RADIUS_M=

# Identidad del build (ver app.config.js)
APP_NOMBRE=Punto de venta
APP_BUNDLE_ID=com.example.pos
APP_ANDROID_PACKAGE=com.example.pos
