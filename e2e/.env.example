# Copiar a e2e/.env.local (que NO se commitea: .gitignore lo tapa con .env*.local)
#
# Todos los guiones son de SOLO LECTURA: no crean ni modifican ordenes, asi
# que se pueden correr contra produccion sin ensuciar nada.

# Contra que ambiente se corre.
#   producción : https://tu-dominio.example
#   PRE        : https://pre.tu-dominio.example
#   local      : http://localhost:3000  (ahi SI se levanta `pnpm dev` solo)
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:3001

# Segundos que se mira la red sin tocar nada. 30 por defecto; bajalo para
# una corrida rapida.
# E2E_VENTANA_REPOSO_SEG=30

# ─── Credenciales, una por rol ───
# NO hay valores por defecto a proposito: el test cuyo rol no tenga credencial
# se SALTA diciendo cual falta, en vez de fallar. Un rojo por un usuario que no
# existe no se distingue de un rojo por una app rota.
#
# Con solo el admin ya corre casi toda la suite: los guiones del POS usan la
# caja si hay, y si no, el admin.

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# E2E_CASHIER_EMAIL=
# E2E_CASHIER_PASSWORD=

# E2E_WAITER_EMAIL=
# E2E_WAITER_PASSWORD=

# E2E_KITCHEN_EMAIL=
# E2E_KITCHEN_PASSWORD=
