# Plantilla de variables de entorno de la API. Copiar a .env y completar.
# Ningún valor de esta plantilla pertenece a un negocio: todo lo que sale a clientes (nombre,
# RIF, teléfono, zona horaria, módulos) vive en la configuración de la base (`configs`), que se
# edita desde Ajustes o con `scripts/sembrar-instancia.mjs`. Ver docs/instancia.md.
#
# Lo que deje en blanco se desactiva con un WARN en el log; nunca usa un valor ajeno por defecto.

# ─── Base de datos y servidor ───────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/pos
PORT=3001

# ─── Sesiones ───────────────────────────────────────────────────────────────
# Obligatoria: sin ella no se firman tokens.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ─── Primer administrador (solo lo lee scripts/sembrar-instancia.mjs) ──────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ─── Red ────────────────────────────────────────────────────────────────────
# Orígenes de la web y del móvil, separados por coma. Vacío = no se agregan cabeceras CORS.
CORS_ORIGINS=
# Solo pruebas locales: abre CORS a cualquier origen (ignorado si CORS_ORIGINS tiene valor).
ENABLE_CORS=0
# Base pública de la API (fotos y archivos subidos). Vacío = rutas relativas.
PUBLIC_BASE_URL=
# Base pública de la app web (enlaces de precuenta y de pago en SMS y correos). Vacío = sin enlace.
PUBLIC_APP_URL=
# Carpeta de archivos subidos. Por defecto ./uploads.
UPLOADS_DIR=

# ─── Avisos por SMS (pasarela de SMS propia: un teléfono Android con la app puente) ──
# Sin SMS_BRIDGE_URL el servicio queda desactivado y solo escribe en el log.
SMS_ENABLED=false
SMS_BRIDGE_URL=
SMS_BRIDGE_KEY=

# ─── Secretos de enlaces y tokens ─────────────────────────────────────────
# Firman los enlaces públicos (precuenta, reportar pago) y la ficha de barra. Obligatorios en uso real.
LINK_SECRET=
FICHA_SECRET=

# ─── WhatsApp (servicio interno de plantillas) ─────────────────────────────
WHATSAPP_SERVICE_URL=
WHATSAPP_API_KEY=
WHATSAPP_TEMPLATE_BUDGET=
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ─── Correos de aviso ───────────────────────────────────────────────────────
# Destino de las solicitudes de baja de cuenta. Vacío = la baja se guarda sin aviso por correo.
ACCOUNT_DELETION_NOTIFY_EMAIL=

# ─── Notificaciones push de Android (FCM) e IA de inventario (opcional) ────
PUSH_ENABLED=false
FCM_SERVICE_ACCOUNT_PATH=
DEEPSEEK_API_KEY=

# ─── Notificaciones push de iOS (APNs, por token .p8) ──────────────────────
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=true

# ─── Pagos móviles ──────────────────────────────────────────────────────────
# false = el bot verifica y deja el flag, pero el cajero aprueba a mano.
# true  = si todos los pagos de la orden quedan verificados, la orden se marca pagada sola.
PAGO_MOVIL_AUTO_COMPLETE=false

# ─── Bot de Telegram de gastos (BotFather). Sin token la API arranca sin bot. ──
# Además el módulo `telegramBot` debe estar encendido en la configuración.
TELEGRAM_BOT_TOKEN=

# ─── Portal bancario y vigilante de divisas (módulos opcionales) ───────────
# Dirección del portal de banca en línea. Sin ella el vigilante y la conciliación no arrancan.
BANK_PORTAL_URL=
BANK_USERNAME=
BANK_PASSWORD=
DIVISAS_NOTIFY_PHONE=
DIVISAS_NOTIFY_EMAIL=
DIVISAS_WINDOW_END=
DIVISAS_CHECK_INTERVAL_SEC=
DIVISAS_ARTIFACTS_DIR=

# ─── Despliegue (rollback desde la bitácora de releases) ───────────────────
# Script que recibe <ámbito> <sha>. Sin esta variable el rollback responde "no configurado".
ROLLBACK_SCRIPT=

# ─── Impresión ─────────────────────────────────────────────────────────────
# Destino de las alertas de falla de impresión (correo) y su intervalo mínimo entre avisos.
PRINT_ALERT_TO=
PRINT_ALERT_COOLDOWN_MIN=
# Clave compartida con el servicio de impresión de la caja (ver print-service-key).
PRINT_SERVICE_KEY=
PRINT_SERVICE_KEY_ENFORCE=false

# ─── Reservas (módulo opcional `reservations`) ─────────────────────────────
RESERVATIONS_NOTIFY_PHONE=

# ── Autenticación ────────────────────────────────────────────────────────
# Por defecto TODO exige sesión (escrituras, lecturas protegidas y roles).
# Solo para depurar o migrar clientes viejos: "false" las abre, "audit" deja
# pasar y registra quién llama sin token.
AUTH_ENFORCE_WRITES=
AUTH_ENFORCE_READS=
AUTH_ENFORCE_ROLES=
