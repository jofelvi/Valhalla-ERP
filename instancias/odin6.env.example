# ═══════════════════════════════════════════════════════════════════════════
#  Instancia odin6 — plantilla para dar de alta una instancia en el VPS.
#  Copiar a  instancias/<nombre>.env  y completar. Este archivo NO se versiona
#  (ver .gitignore) y no lleva secretos: las claves van en /etc/<nombre>/
#  (ver docs/instancia.md). Los puertos 3201/3202/9092 son los de odin6: no
#  tocar los de otra instancia.
# ═══════════════════════════════════════════════════════════════════════════

INSTANCIA=odin6

# Dominios públicos (sin http:// ni barra). Apuntar su DNS al VPS antes de dar de alta.
DOMINIO_WEB=pos.example.com
DOMINIO_API=pos-api.example.com

# Puertos locales (127.0.0.1). Deben estar libres en el VPS.
PUERTO_API=3201
PUERTO_WEB=3202
PUERTO_WEBHOOK=9092
# Opcional: dirección donde escucha la web. Por defecto 127.0.0.1 (detrás de nginx); 0.0.0.0 solo para probar por IP:puerto.
#BIND_WEB=127.0.0.1

# Base de Mongo de la instancia (una base por cliente).
BASE_MONGO=odin6

# Carpeta padre de las carpetas de la instancia (<INSTANCIA>-build, -api, -web-*).
DIR_BASE=/var/www

# Repositorio que despliega la instancia y rama que dispara el despliegue.
REPO_URL=git@github.com:OWNER/odin6-pos.git
RAMA=main

# Correo para certbot y para los avisos de despliegue.
EMAIL_AVISOS=ops@example.com
