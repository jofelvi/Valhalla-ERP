# Web POS (Next.js). Copiar a .env.local para desarrollo, o a .env.production en el servidor.
# Los NEXT_PUBLIC_* se hornean en el build: cambiarlos exige recompilar.

# ── Autenticación (NextAuth) ─────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Opcional: inicio de sesión con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── API ──────────────────────────────────────────────────────────────────
# URL pública de la API (la ve el navegador).
NEXT_PUBLIC_API_URL=http://localhost:3001
# URL interna de la API vista desde el servidor de Next (opcional; si falta se usa la pública).
API_URL=
# URL pública de esta web (metadata, enlaces en correos). Si falta se deduce de las cabeceras.
NEXT_PUBLIC_SITE_URL=

# ── Correo saliente (opcional) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── WhatsApp (opcional) ──────────────────────────────────────────────────
WHATSAPP_SERVICE_URL=
WHATSAPP_SERVICE_API_KEY=
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_TEMPLATE_PEDIDO_ENTREGADO=
WHATSAPP_TEMPLATE_PAGO_PENDIENTE=
WHATSAPP_TEMPLATE_PURCHASE_RECEIPT=

# ── Conciliación bancaria (opcional, módulo "bankReconciliation") ────────
BDV_API_KEY=
BDV_TELEFONO_DESTINO=
BDV_API_ENDPOINT=
