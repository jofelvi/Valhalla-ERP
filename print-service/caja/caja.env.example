# ===========================================================================
#  Configuracion de la PC de caja. Copiar este archivo a  caja.env  (junto a
#  los scripts de caja). caja.env NO se versiona: cada instalacion tiene el suyo.
#  Sin secretos: la clave del servicio va en el .env del servicio
#  (PRINT_SERVICE_KEY), no aqui.
# ===========================================================================

# Prefijo de las tareas programadas de Windows (<INSTANCIA>-impresion, ...).
INSTANCIA=mi-negocio

# Carpeta de los scripts de caja y del estado de impresoras (por defecto, ProgramData\<INSTANCIA>).
DIR_INSTALACION=C:\print-service-caja

# Carpeta del servicio de impresion (la que tiene dist\index.js y .env).
DIR_SERVICIO=C:\print-service
# Node.exe. Vacio = el que esta en el PATH.
NODE_EXE=
# both | kitchen | bar | bar-1 | bar-2 | kitchen+1 (ver README del servicio)
STATION_MODE=both

# API del backend (sin barra final). Obligatoria para recibir trabajos.
API_URL=https://api.ejemplo.com
# Puerto del servicio local.
PUERTO_SERVICIO=6441

# Conector fisico -> nombre de la impresora en Windows. Los puertos USB (USB00x)
# rotan tras cada corte de luz; el conector fisico no. Formato:
#   MAPA_PUERTOS=<conector>=<nombre>;<conector>=<nombre>
# Para ver los conectores, correr identificar-impresoras.ps1 con la impresora rotulada.
MAPA_PUERTOS=

# Impresoras a vigilar (patron de Windows). Por defecto, todas.
PATRON_IMPRESORAS=*

# Tunel de soporte al VPS (opcional). Vacio = no se instala la tarea del tunel.
VPS_HOST=
VPS_USUARIO=root
VPS_PUERTO_REMOTO=2222
# Llave SSH del tunel. Se copia a DIR_INSTALACION con ACL solo-SYSTEM.
TUNEL_CLAVE_ORIGEN=
